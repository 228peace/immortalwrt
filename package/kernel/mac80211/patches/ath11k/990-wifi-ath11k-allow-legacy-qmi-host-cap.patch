 static const struct qmi_elem_info qmi_wlanfw_ind_register_req_msg_v01_ei[] = {
 	{
 		.data_type	= QMI_OPT_FLAG,
@@ -1766,10 +2017,19 @@ static int ath11k_qmi_host_cap_send(stru
 	if (ret < 0)
 		goto out;
 
+	const struct qmi_elem_info *req_ei;
+
+	if (ab->hw_params.fixed_mem_region ||
+	    of_machine_is_compatible("askey,rt5010w-d156") ||
+	    of_machine_is_compatible("askey,rt5010w-d156-rev1"))
+		req_ei = ath11k_qmi_host_cap_8bit_req_msg_v01_ei;
+	else
+		req_ei = qmi_wlanfw_host_cap_req_msg_v01_ei;
+
 	ret = qmi_send_request(&ab->qmi.handle, NULL, &txn,
 			       QMI_WLANFW_HOST_CAP_REQ_V01,
 			       QMI_WLANFW_HOST_CAP_REQ_MSG_V01_MAX_LEN,
-			       qmi_wlanfw_host_cap_req_msg_v01_ei, &req);
+			       req_ei, &req);
 	if (ret < 0) {
 		qmi_txn_cancel(&txn);
 		ath11k_warn(ab, "failed to send host capability request: %d\n", ret);
@@ -1781,10 +2039,16 @@
 		goto out;
 
 	if (resp.resp.result != QMI_RESULT_SUCCESS_V01) {
-		ath11k_warn(ab, "host capability request failed: %d %d\n",
+		ath11k_warn(ab, "host capability response: result %d error %d\n",
 			    resp.resp.result, resp.resp.error);
-		ret = -EINVAL;
-		goto out;
+		if (resp.resp.error == QMI_ERR_MALFORMED_MSG_V01 ||
+		    resp.resp.error == QMI_ERR_NOT_SUPPORTED_V01) {
+			ath11k_warn(ab, "ignoring unsupported host capability request for legacy firmware\n");
+			ret = 0;
+		} else {
+			ret = -EINVAL;
+			goto out;
+		}
 	}
 
